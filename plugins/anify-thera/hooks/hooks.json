{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/anify_character_hooks.py\" session-start --character Thera",
            "timeout": 30,
            "statusMessage": "Loading Thera memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/anify_character_hooks.py\" user-prompt --character Thera",
            "timeout": 30,
            "statusMessage": "Recording Thera context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/anify_character_hooks.py\" stop --character Thera",
            "timeout": 30,
            "statusMessage": "Saving Thera transcript"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/anify_character_hooks.py\" post-compact --character Thera",
            "timeout": 60,
            "statusMessage": "Updating Thera memory"
          }
        ]
      }
    ]
  }
}
